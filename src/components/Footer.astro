---
import { SITE_INFO } from '../data/siteData';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#23262C] bg-[#0B0C0E] text-white" data-agent-entity="site-footer">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/15">
      <!-- Identity Column -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img
            src={SITE_INFO.logoWordmark}
            alt="Dr. Trevor Kouritzin — Evidence Based Recommendations"
            width="220"
            height="78"
            referrerpolicy="no-referrer"
            class="h-12 w-auto object-contain"
          />
        </a>
        <p class="text-sm leading-relaxed text-[#A1A7B3] max-w-sm">
          Ph.D. in Medicine (Preventive Medicine) · M.Sc. Human Nutrition · B.Sc. Chemical Engineering · IFBB Pro.
        </p>
        <p class="text-sm text-[#A1A7B3]">
          {SITE_INFO.location} ·{' '}
          <a
            href={`mailto:${SITE_INFO.email}`}
            class="text-[#8AB4DC] font-medium underline decoration-[#8AB4DC]/40 underline-offset-4 hover:decoration-[#8AB4DC]"
          >
            {SITE_INFO.email}
          </a>
        </p>
      </div>

      <!-- Navigation Column -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold tracking-wide text-white/60">Directory</h3>
        <ul class="space-y-2.5 text-sm text-[#D1D5DB]">
          <li><a href="/" class="hover:text-[#8AB4DC] transition-colors">Home</a></li>
          <li><a href="/services" class="hover:text-[#8AB4DC] transition-colors">Services &amp; Monographs</a></li>
          <li><a href="/meet-trevor" class="hover:text-[#8AB4DC] transition-colors">Meet Trevor</a></li>
          <li><a href="/articles" class="hover:text-[#8AB4DC] transition-colors">Research Articles</a></li>
          <li><a href="/publications" class="hover:text-[#8AB4DC] transition-colors">Publications</a></li>
          <li><a href="/contact" class="hover:text-[#8AB4DC] transition-colors">Contact &amp; Speaking</a></li>
        </ul>
      </div>

      <!-- Connect & Machine-Readable Discovery Column -->
      <div class="md:col-span-4 space-y-6">
        <div class="space-y-3">
          <h3 class="text-xs font-semibold tracking-wide text-white/60">Social &amp; Media</h3>
          <div class="flex items-center gap-3">
            <a
              href="https://www.instagram.com/trevorkouritzin/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="w-10 h-10 rounded-full bg-[#1C2026] border border-white/15 text-white inline-flex items-center justify-center hover:border-[#8AB4DC] transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
              </svg>
            </a>
            <a
              href="https://www.youtube.com/trevorkouritzin"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="w-10 h-10 rounded-full bg-[#DC2626] text-white inline-flex items-center justify-center hover:opacity-90 transition-opacity"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/trevor-kouritzin-9b8558209/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="w-10 h-10 rounded-full bg-[#0A66C2] text-white inline-flex items-center justify-center hover:opacity-90 transition-opacity"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </div>
        </div>

        <div class="space-y-2 pt-4 border-t border-white/15">
          <p class="text-xs font-medium text-white/60">Machine-Readable Index</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-[#A1A7B3]">
            <a href="/llms.txt" class="hover:text-[#8AB4DC] underline underline-offset-2">llms.txt</a>
            <span aria-hidden="true">·</span>
            <a href="/api/profile.json" class="hover:text-[#8AB4DC] underline underline-offset-2">profile.json</a>
            <span aria-hidden="true">·</span>
            <a href="/rss.xml" class="hover:text-[#8AB4DC] underline underline-offset-2">rss.xml</a>
            <span aria-hidden="true">·</span>
            <a href="/sitemap-index.xml" class="hover:text-[#8AB4DC] underline underline-offset-2">sitemap</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#A1A7B3]">
      <p>&copy; {currentYear} {SITE_INFO.name}. All rights reserved.</p>
      <p class="font-serif italic text-sm text-white/80">{SITE_INFO.tagline}</p>
    </div>
  </div>
</footer>
