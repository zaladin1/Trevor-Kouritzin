---
import { SITE_INFO } from '../data/siteData';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  canonicalPath = '/',
  ogImage = SITE_INFO.images.hero,
  ogType = 'website',
  publishedTime,
  jsonLd,
  breadcrumbs,
} = Astro.props;

const baseUrl = (Astro.site?.toString() || SITE_INFO.siteUrl).replace(/\/$/, '');
const canonicalUrl = `${baseUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${baseUrl}${ogImage}`;

const personSchema = {
  '@type': 'Person',
  '@id': `${baseUrl}/#person`,
  name: SITE_INFO.name,
  alternateName: 'Doctor Trev',
  url: baseUrl,
  image: `${baseUrl}${SITE_INFO.images.hero}`,
  email: SITE_INFO.email,
  jobTitle: 'Clinical Nutrition Researcher, Supplement Formulation Specialist & IFBB Pro',
  description:
    'Dr. Trevor Kouritzin holds a Ph.D. in Medicine (Preventive Medicine), M.Sc. in Human Nutrition, and B.Sc. in Chemical Engineering from the University of Alberta.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Edmonton',
    addressRegion: 'AB',
    addressCountry: 'CA',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'University of Alberta',
    },
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: 'Ph.D. in Medicine (Division of Preventive Medicine)',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: 'M.Sc. in Human Nutrition',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: 'B.Sc. in Chemical Engineering',
    },
  ],
  knowsAbout: [
    'Clinical Nutrition',
    'Preventive Medicine',
    'Dietary Supplement Formulation',
    'Ketogenic Diets',
    'Endocrinology & Testosterone Physiology',
    'Sports Performance & Hypertrophy',
    'Allometric Dose Scaling',
  ],
  sameAs: [
    ...SITE_INFO.socials.map((s) => s.url),
    'https://www.researchgate.net/scientific-contributions/Trevor-Kouritzin-2156262697',
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${baseUrl}/#website`,
  url: baseUrl,
  name: SITE_INFO.name,
  description: SITE_INFO.heroHeadline,
  publisher: { '@id': `${baseUrl}/#person` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${baseUrl}/articles?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const breadcrumbSchema = breadcrumbs
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.name,
        item: `${baseUrl}${item.path}`,
      })),
    }
  : null;

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, websiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...extraSchemas],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_INFO.name} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />

<!-- AI Agent & Machine-Readable Discovery Links -->
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_INFO.name} — Research Articles RSS`} href="/rss.xml" />
<link rel="alternate" type="application/json" title={`${SITE_INFO.name} — Structured Agent Profile`} href="/api/profile.json" />
<link rel="alternate" type="text/plain" title="LLMs.txt Summary" href="/llms.txt" />

<!-- OpenGraph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_INFO.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Favicon using authentic brand mark -->
<link rel="icon" type="image/png" href="/images/logo-mark.png" />

<!-- Typography (2+1 Rule: Cormorant Garamond + Plus Jakarta Sans + JetBrains Mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<!-- Structured Data JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
