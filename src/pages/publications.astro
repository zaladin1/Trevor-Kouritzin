---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationsList from '../components/PublicationsList';
import { PUBLICATIONS, SITE_INFO } from '../data/siteData';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Publications', path: '/publications' },
];

const scholarlySchemas = PUBLICATIONS.map((pub) => ({
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  author: pub.authors.split(',').map((name) => ({ '@type': 'Person', name: name.trim() })),
  datePublished: String(pub.year),
  isPartOf: {
    '@type': 'Periodical',
    name: pub.journalOrVenue,
  },
  about: pub.focusArea,
}));
---

<BaseLayout
  title="Peer-Reviewed Publications — Dr. Trevor Kouritzin"
  description="Academic journal articles and conference proceedings by Dr. Trevor Kouritzin across preventive medicine, dietary supplementation, and muscle anabolism."
  canonicalPath="/publications"
  ogImage={SITE_INFO.images.publications}
  breadcrumbs={breadcrumbs}
  jsonLd={scholarlySchemas}
>
  <section class="border-b border-white/15 bg-[#0B0C0E] text-white">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-4">
          <p class="text-xs font-semibold tracking-wide text-white/60">
            Academic Bibliography
          </p>
          <h1 class="font-serif text-4xl sm:text-6xl font-medium text-white tracking-tight leading-[1.06]">
            Bridging Medicine, Nutrition, and Performance
          </h1>
          <p class="text-base sm:text-lg text-[#B6BCC8] leading-relaxed max-w-2xl">
            My interdisciplinary background in medicine, human nutrition, and chemical engineering, combined with competitive bodybuilding, informs peer-reviewed research on dietary supplementation, cardiovascular risk, and healthy aging.
          </p>
        </div>

        <div class="lg:col-span-4">
          <div class="aspect-square max-w-[300px] lg:ml-auto overflow-hidden border border-white/15 bg-[#16181D]">
            <img
              src={SITE_INFO.images.publications}
              alt="Dr. Trevor Kouritzin in academic library"
              width="600"
              height="600"
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-10">
      <PublicationsList client:load publications={PUBLICATIONS} />
    </div>
  </section>
</BaseLayout>
